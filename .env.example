# Run from the project root, or set JOBSCRAP_ENV_FILE to an absolute .env path.
# Paste Atlas's Python connection string; URL-encode special password characters.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=jobscrap
MONGODB_TIMEOUT_MS=5000
RESUME_PATH=Pranav_Gaur_Resume.pdf
STATE_DIR=var
LOG_LEVEL=INFO
# Optional outbound contact in the identifiable scraper user agent.
SCRAPER_USER_AGENT=JobScrap/0.1
HTTP_TIMEOUT_SECONDS=20
REQUEST_INTERVAL_SECONDS=2
HTTP_ATTEMPTS=3
MAX_RESPONSE_BYTES=5000000
# No paid AI calls by default. Set hybrid to enable LangChain scoring.
MATCHING_MODE=deterministic
AI_PROVIDER=openai
# Choose a model available to your account that supports structured output.
AI_MODEL=
OPENAI_API_KEY=
AI_MAX_CALLS_PER_RUN=20
AI_PREFILTER_MIN_SCORE=15
AI_TIMEOUT_SECONDS=30
# Loopback by default; use an SSH tunnel or an HTTPS reverse proxy on the VM.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Set BOTH before exposing the dashboard beyond loopback. Basic auth requires TLS.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
